{
  "name": "@qqax/design-editor",
  "version": "1.0.0-beta.11",
  "private": false,
  "description": "Open-source image design editor for React and Next.js",
  "license": "MIT",
  "author": "qqax.ai",
  "keywords": [
    "react",
    "nextjs",
    "design",
    "editor",
    "image-editor",
    "canvas",
    "fabricjs",
    "qqax"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qqax/design-editor.git"
  },
  "homepage": "https://qqax.ai",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tailwindcss -i src/theme/theme.css -o dist/theme.css && node scripts/postbuild-use-client.mjs",
    "dev:js": "tsup --watch",
    "dev:css": "tailwindcss -i src/theme/theme.css -o dist/theme.css --watch",
    "dev": "concurrently \"npm:dev:js\" \"npm:dev:css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "size": "size-limit",
    "publish:all": "npm publish --tag latest --@qqax:registry=https://registry.npmjs.org/ && npm publish --tag latest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@imgly/background-removal": "1.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "fabric": "7.4.0",
    "lucide-react": "^1.44.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/lodash": "^4.17.25",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-airbnb-extended": "^3.2.0",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "jsdom": "^30.0.1",
    "lodash": "^4.18.1",
    "playground": "^0.7.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer": "^25.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resize-observer-polyfill": "^1.5.1",
    "size-limit": "^13.0.3",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "5.7.3",
    "vitest": "^5.0.0"
  }
}
