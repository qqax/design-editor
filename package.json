{
  "name": "@fastlabai/design-editor",
  "version": "1.0.0-beta.11",
  "description": "Open-source image design editor for React and Next.js",
  "license": "MIT",
  "author": "fastlab.ai",
  "keywords": [
    "react",
    "nextjs",
    "design",
    "editor",
    "image-editor",
    "canvas",
    "fabricjs",
    "fastlabai"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastlabai/design-editor.git"
  },
  "homepage": "https://fastlab.ai",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tailwindcss -i src/theme/theme.css -o dist/theme.css && node scripts/postbuild-use-client.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "size": "size-limit",
    "publish:all": "npm publish --tag latest --@fastlabai:registry=https://registry.npmjs.org/ && npm publish --tag latest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@imgly/background-removal": "1.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "fabric": "7.4.0",
    "lucide-react": "^0.511.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/lodash": "^4.17.25",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "lodash": "^4.18.1",
    "postcss": "^8.5.26",
    "puppeteer": "^25.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resize-observer-polyfill": "^1.5.1",
    "size-limit": "^11.2.0",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}